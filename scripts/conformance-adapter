#!/usr/bin/env sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
classpath_file="$repo_dir/target/conformance-classpath.txt"
adapter_class="$repo_dir/target/test-classes/org/portolan/ConformanceAdapter.class"
needs_build=false
if [ ! -f "$classpath_file" ] || [ ! -f "$adapter_class" ]; then
  needs_build=true
elif find "$repo_dir/src" "$repo_dir/pom.xml" -type f -newer "$classpath_file" -print -quit \
    | grep -q .; then
  needs_build=true
fi
if [ "$needs_build" = true ]; then
  mvn -q -f "$repo_dir/pom.xml" test-compile dependency:build-classpath \
    -Dmdep.outputFile="$classpath_file" -Dmdep.includeScope=test >&2
fi
exec java -cp "$repo_dir/target/test-classes:$repo_dir/target/classes:$(cat "$classpath_file")" \
  org.portolan.ConformanceAdapter
